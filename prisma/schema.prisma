generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameId        String   @map("name_id")
  nameEn        String   @map("name_en")
  descriptionId String?  @map("description_id")
  descriptionEn String?  @map("description_en")
  price         Int
  category      String
  imageUrl      String?  @map("image_url")
  weight        Int      @default(0) @map("weight")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  whatsappText  String?  @map("whatsapp_text")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model BlogPost {
  id          String    @id @default(cuid())
  titleId     String    @map("title_id")
  titleEn     String    @map("title_en")
  slug        String    @unique
  contentId   String?   @map("content_id") @db.Text
  contentEn   String?   @map("content_en") @db.Text
  excerptId   String?   @map("excerpt_id")
  excerptEn   String?   @map("excerpt_en")
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model GalleryVideo {
  id        String   @id @default(cuid())
  slot      Int      @unique
  titleId   String   @map("title_id")
  titleEn   String   @map("title_en")
  videoUrl  String?  @map("video_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("gallery_videos")
}

model SiteSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
